# Copy this file to .env and adjust values before first deployment.
# .env is loaded automatically by docker compose.

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------
POSTGRES_USER=scg
POSTGRES_PASSWORD=Checkout123
POSTGRES_DB=scg

# --------------------------------------------------
# GUI / nginx external port
# --------------------------------------------------
# Change if port 80 is taken on the host.
GUI_PORT=80

# --------------------------------------------------
# InfluxDB (only needed with --profile storage)
# --------------------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=Admin@123!
INFLUX_ORG=scg
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=scg-influx-token-change-me

# --------------------------------------------------
# IAM secrets — CHANGE before production use
# Update docker/config/iam.yaml jwt_secret as well.
# --------------------------------------------------
# IAM_JWT_SECRET=replace-with-32-plus-random-bytes-base64-encoded
